{
  "name": "cassandra-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && (bun run build:web --watch & bun --watch src/server/index.ts)",
    "build": "bun run build:web",
    "build:web": "bun build ./web/index.html --outdir ./dist --minify",
    "start": "bun src/server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "cassandra-driver": "^4.10.0",
    "codemirror": "^6.0.2",
    "elysia": "^1.4.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
